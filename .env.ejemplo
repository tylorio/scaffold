# Copia este archivo como .env (no se versiona) y genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=pon-aqui-una-clave-nueva
# 1 solo en la máquina de desarrollo; sin esta línea, DEBUG queda en False.
DJANGO_DEBUG=1
# Sal del HMAC de los correos de commit (D19). Genérala una vez con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# No la cambies durante el estudio y respáldala con la clave del almacén.
IDC_SAL_CORREOS=pon-aqui-una-sal-nueva
